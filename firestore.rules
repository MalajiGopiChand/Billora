rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Checks if the user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Admin check (the owner email)
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'thegopichand@gmail.com';
    }
    
    // Checks if the document belongs to the currently logged in user
    function isOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Checks if the user is creating a document with their own user ID
    function isCreatingWithOwnerId() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Plan validity only. Shop records stay stored after expiry.
    function hasActiveSubscription() {
      let path = /databases/$(database)/documents/subscriptions/$(request.auth.uid);
      return exists(path) && get(path).data.expiresAt is timestamp && get(path).data.expiresAt > request.time;
    }

    function canUseShopData() {
      return hasActiveSubscription() || isAdmin();
    }

    // Settings Collection
    match /company_settings/{settingId} {
      allow read, write: if isAuthenticated() && request.auth.uid == settingId && canUseShopData();
    }
    
    // Products Collection
    match /products/{productId} {
      allow read, update, delete: if isOwner() && canUseShopData();
      allow create: if isCreatingWithOwnerId() && canUseShopData();
    }
    
    // Invoices / Bills Collection
    match /invoices/{invoiceId} {
      allow read, update, delete: if isOwner() && canUseShopData();
      allow create: if isCreatingWithOwnerId() && canUseShopData();
    }
    match /bills/{billId} {
      allow read, update, delete: if isOwner() && canUseShopData();
      allow create: if isCreatingWithOwnerId() && canUseShopData();
    }
    
    // Orders Collection
    match /orders/{orderId} {
      allow read, update, delete: if isOwner() && canUseShopData();
      allow create: if isCreatingWithOwnerId() && canUseShopData();
    }
    
    // Customers Collection
    match /customers/{customerId} {
      allow read, update, delete: if isOwner() && canUseShopData();
      allow create: if isCreatingWithOwnerId() && canUseShopData();
    }
    
    // Users Collection (Users can only read/write their own record, Admin can read all)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAdmin();
    }
    
    // Subscriptions Collection (Users can read/write their own)
    match /subscriptions/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }
    
    // Contact Messages Collection (Users can create, Admin can read/write)
    match /contact_messages/{messageId} {
      allow create: if isCreatingWithOwnerId();
      allow read, write: if isAdmin();
    }
  }
}
