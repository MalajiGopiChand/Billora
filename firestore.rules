rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Checks if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Checks if the user is an Administrator / Owner
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'thegopichand@gmail.com' ||
        request.auth.token.email == 'maramnagaprasad1992@gmail.com' ||
        request.auth.token.admin == true
      );
    }
    
    // Checks if the document belongs to the currently logged in user
    function isOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Checks if the user is creating a document with their own user ID
    function isCreatingWithOwnerId() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // 1. Company Settings Collection (User owns their record; Admin has full access to read/write/delete)
    match /company_settings/{settingId} {
      allow read, write: if (isAuthenticated() && request.auth.uid == settingId) || isAdmin();
    }
    
    // 2. Products Collection (Owner or Admin)
    match /products/{productId} {
      allow read, update, delete: if isOwner() || isAdmin();
      allow create: if isCreatingWithOwnerId() || isAdmin();
    }
    
    // 3. Invoices / Bills Collection (Owner or Admin)
    match /invoices/{invoiceId} {
      allow read, update, delete: if isOwner() || isAdmin();
      allow create: if isCreatingWithOwnerId() || isAdmin();
    }
    match /bills/{billId} {
      allow read, update, delete: if isOwner() || isAdmin();
      allow create: if isCreatingWithOwnerId() || isAdmin();
    }
    
    // 4. Orders Collection (Owner or Admin)
    match /orders/{orderId} {
      allow read, update, delete: if isOwner() || isAdmin();
      allow create: if isCreatingWithOwnerId() || isAdmin();
    }
    
    // 5. Customers Collection (Owner or Admin)
    match /customers/{customerId} {
      allow read, update, delete: if isOwner() || isAdmin();
      allow create: if isCreatingWithOwnerId() || isAdmin();
    }
    
    // 6. Users Collection (User can manage their own profile; Admin can read, write, update, and DELETE client accounts)
    match /users/{userId} {
      allow read, write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
    }
    
    // 7. Subscriptions Collection (User can read/write their own; Admin can read, write, update, and DELETE)
    match /subscriptions/{userId} {
      allow read, write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
    }
    
    // 8. Contact Messages Collection (Visitors can submit inquiries; Admin can read, resolve, and DELETE messages)
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, write, delete: if isAdmin();
    }

    // 9. Site Settings (Public read for announcements/notices; Admin can write)
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
